{
  "$id": "https://lfighter.local/schemas/lfighter_hybrid_narrative_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "executive_summary": {
      "maxLength": 600,
      "minLength": 1,
      "pattern": "^[^0-9]*$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "executive_summary"
  ],
  "title": "LFighter hybrid qualitative narrative",
  "type": "object"
}
