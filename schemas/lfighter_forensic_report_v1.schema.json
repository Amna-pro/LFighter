{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lfighter.local/schemas/lfighter_forensic_report_v1.schema.json",
  "title": "LFighter grounded forensic report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "report_title",
    "executive_summary",
    "facts",
    "interpretations",
    "uncertainties",
    "refusals",
    "authority_statement"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "report_title": {"type": "string", "minLength": 1, "maxLength": 120},
    "executive_summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "facts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/cited_statement"}
    },
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/interpretation"}
    },
    "uncertainties": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1, "maxLength": 280}
    },
    "refusals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "authority_statement": {
      "const": "Informational report only; the deterministic LFighter pipeline retains all security decision authority."
    }
  },
  "$defs": {
    "cited_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_refs"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 360},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^src:"}
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "confidence", "evidence_refs"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 360},
        "confidence": {"enum": ["low", "moderate", "high"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^src:"}
        }
      }
    }
  }
}
